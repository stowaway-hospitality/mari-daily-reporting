+  .rs-table small{opacity:.65;margin-left:4px}
+  .rs-chip{display:inline-block;padding:2px 9px;border-radius:99px;font-size:11px;font-weight:700}
+  .rs-chip.warn{background:color-mix(in srgb,var(--amber) 18%,transparent);color:var(--amber)}
+  .rs-chip.good{background:color-mix(in srgb,var(--green) 16%,transparent);color:var(--green)}
+  .rs-chip.mute{background:color-mix(in srgb,var(--ink) 10%,transparent);color:var(--ink-soft)}
+  .rs-empty{font-size:13px;color:var(--ink-soft);line-height:1.5}
 </style>
 <script src="/_shared/pnl.js"></script>
 <script src="/_shared/util.js"></script>
 <script src="/_shared/data.js"></script>
+<script type="module">
+  // render.js is a classic script, so it cannot import an ES module. Hand it
+  // the mount instead; it calls this whenever the dashboard repaints.
+  import { mountRestatements } from '/_shared/restatements.js';
+  window.__mountRestatements = mountRestatements;
+</script>
 <script src="/_shared/render.js"></script>
 </head>
 <script>
@@ -568,6 +588,14 @@ tbody tr:hover { background: var(--group-tint); }
