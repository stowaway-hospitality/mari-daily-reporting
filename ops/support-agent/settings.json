{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git commit:*)",
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(launchctl:*)",
      "Bash(crontab:*)",
      "Bash(gh secret:*)",
      "Bash(gh repo delete:*)",
      "Read(./.secrets/**)",
      "Edit(./.secrets/**)",
      "Write(./.secrets/**)",
      "Edit(./.github/workflows/**)",
      "Write(./.github/workflows/**)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(gh run:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/ops/support-agent/guard.py\"" }
        ]
      }
    ]
  }
}
