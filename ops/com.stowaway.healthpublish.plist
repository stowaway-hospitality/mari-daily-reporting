<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.stowaway.healthpublish</string>
  <!-- Runs the STANDALONE branch-proof publisher (installed at
       ~/.stowaway-ops/publish_health.py, canonical source ops/publish_health.py)
       so a branch switch of the shared working tree can't change what it runs.
       Install: cp ops/publish_health.py ~/.stowaway-ops/ ; launchctl load -w this. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>/usr/bin/python3 -u "$HOME/.stowaway-ops/publish_health.py"</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>StandardOutPath</key><string>/Users/stowaway/.stowaway-ops/health_publish.log</string>
  <key>StandardErrorPath</key><string>/Users/stowaway/.stowaway-ops/health_publish.log</string>
</dict>
</plist>
